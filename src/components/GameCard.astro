---
import {content, type Locale} from '../data/content';
import {pathFor} from '../lib/site';
interface Props {locale: Locale}
const {locale} = Astro.props;
const c = content[locale];
---
<a class="game-card" href={pathFor(locale,'games/hoegwi-button')}>
  <div class="game-card-art"><img class="room-art" src="/media/room.webp" alt="" width="1536" height="1024" loading="lazy" /><div class="art-shade"></div><img class="game-icon" src="/media/icon-a.webp" alt="" width="768" height="768" loading="lazy" /><span class="year-tag">2006<span>→</span></span></div>
  <div class="game-card-info"><div><span class="eyebrow">{locale === 'ko' ? '출시작' : 'RELEASED GAME'}</span><h3>{c.game.name}</h3><p>{c.home.gameDescription}</p></div><span class="round-arrow" aria-label={c.games.detailCta}>↗</span></div>
</a>

