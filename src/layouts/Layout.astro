---
import '../styles/global.css';
import '../styles/dark.css';
import Brand from '../components/Brand.astro';
import { content, facts, type Locale } from '../data/content';
import { pathFor, absolute, pageInfo, structuredData, isPolicyDraft, assertPublicationReady, type Route } from '../lib/site';
import {type NewsPost,newsAuthor} from '../data/news';
interface Props { locale: Locale; route: Route; article?: NewsPost }
const { locale, route, article } = Astro.props;
const c = content[locale];
const info = article ? {title:article[locale].title,description:article[locale].summary} : pageInfo(locale, route);
const currentRoute = article ? `news/${article.slug}` : route;
const schema = structuredData(locale,route);
if(article){
  const url=absolute(pathFor(locale,currentRoute));
  const page=schema['@graph'].find(e=>e['@type']==='WebPage');
  if(page)Object.assign(page,{'@id':`${url}#webpage`,url,name:info.title,description:info.description,mainEntity:{'@id':`${url}#article`}});
  schema['@graph'].push({'@type':'Article','@id':`${url}#article`,url,headline:info.title,description:info.description,articleBody:article[locale].paragraphs.join('\n\n'),inLanguage:locale,datePublished:article.publishedAt,...(article.dateModified?{dateModified:article.dateModified}:{}),author:{'@type':'Organization','@id':`${facts.domain}/#organization`,name:newsAuthor},publisher:{'@id':`${facts.domain}/#organization`},mainEntityOfPage:{'@id':`${url}#webpage`}});
}
const other = locale === 'ko' ? 'en' : 'ko';
const isPublic = import.meta.env.PUBLIC_RELEASE === 'true';
const siteProfile = isPublic || import.meta.env.SITE_PROFILE === 'website' ? 'website' : 'review';
if (isPublic) assertPublicationReady(siteProfile);
const title = route ? `${info.title} — ${facts.brand}` : `${facts.brand} · ${facts.brandKo}`;
const nav = [{key:'philosophy',label:c.nav.philosophy},{key:'games',label:c.nav.games},{key:'studio',label:c.nav.studio},{key:'news',label:c.nav.news}];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171a19" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={info.description} />
    <meta name="robots" content={isPublic && !isPolicyDraft(route) ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={absolute(pathFor(locale, currentRoute))} />
    <link rel="alternate" hreflang="ko" href={absolute(pathFor('ko', currentRoute))} />
    <link rel="alternate" hreflang="en" href={absolute(pathFor('en', currentRoute))} />
    <link rel="alternate" hreflang="x-default" href={absolute(pathFor('ko', currentRoute))} />
    <link rel="icon" type="image/png" href="/media/detailoop-logo.png" />
    <link rel="preload" href="/fonts/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={facts.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={info.description} />
    <meta property="og:url" content={absolute(pathFor(locale, currentRoute))} />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:image" content={absolute(route.startsWith('games') ? '/media/share-game.jpg' : '/media/share-studio.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={route.startsWith('games') ? facts.gameName : facts.brand} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'ko' ? '본문으로 건너뛰기' : 'Skip to content'}</a>
    <header class="header">
      <Brand locale={locale} />
      <nav aria-label={locale === 'ko' ? '주 메뉴' : 'Main navigation'}>
        {nav.map(item => <a href={pathFor(locale,item.key)} aria-current={route.startsWith(item.key) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <a class="language" href={pathFor(other,currentRoute)} lang={other} aria-label={other === 'en' ? 'View this page in English' : '이 페이지 한국어로 보기'}>{other === 'en' ? 'EN' : 'KO'} <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="footer-main"><Brand locale={locale}/><p>{c.studio.tagline}</p></div>
      <div class="footer-bottom"><div><span>{facts.brand} · {facts.brandKo}</span><small>{c.footer.copyright}</small></div><nav aria-label={locale === 'ko' ? '하단 메뉴' : 'Footer navigation'}><a href={pathFor(locale,'contact')}>{locale === 'ko' ? '문의' : 'Contact'}</a><a href={`${pathFor(locale,'contact')}#account-deletion`}>{locale === 'ko' ? '계정 삭제 요청' : 'Account deletion'}</a>{(siteProfile === 'review' || !isPolicyDraft('policies/terms')) && <a href={pathFor(locale,'policies/terms')}>{locale === 'ko' ? '이용약관' : 'Terms'}</a>}<a href={pathFor(locale,siteProfile === 'website' ? 'policies/site-privacy' : 'policies')}>{locale === 'ko' ? '개인정보처리방침' : 'Privacy'}</a></nav></div>
    </footer>
  </body>
</html>
