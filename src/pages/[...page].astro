---
import Layout from '../../layouts/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import StoreButton from '../../components/StoreButton.astro';
import Founder from '../../components/Founder.astro';
import {content, facts, locales, type Locale} from '../../data/content';
import {buildRoutes, pathFor, isPolicyDraft, type Route} from '../../lib/site';
import {posts,newsCategories} from '../../data/news';
import {policyDocuments,policyOperationRules,policyReadiness,type PolicyKey} from '../../data/policies';
export function getStaticPaths() {const profile=import.meta.env.PUBLIC_RELEASE === 'true' || import.meta.env.SITE_PROFILE === 'website' ? 'website' : 'review';return locales.flatMap(locale => buildRoutes(profile).map(route => ({params:{locale,page:route || undefined},props:{locale,route}})));}
interface Props {locale: Locale; route: Route}
const {locale,route} = Astro.props;
const c=content[locale];
const ko=locale==='ko';
const {d1RecoveryDays,supportRetentionDays}=policyOperationRules;
const siteProfile = import.meta.env.PUBLIC_RELEASE === 'true' || import.meta.env.SITE_PROFILE === 'website' ? 'website' : 'review';
const includedRoutes = buildRoutes(siteProfile);
const screens=[['life',ko?'생활 계획':'Planning your life'],['investment',ko?'투자':'Investments'],['career',ko?'커리어와 배움':'Career and learning'],['home',ko?'주거':'A place to live'],['story',ko?'이야기와 선택':'Stories and choices'],['encounter',ko?'인연':'Encounters']];
const policyNames: Record<string,string>={'policies/terms':c.policies.terms,'policies/game-privacy':c.policies.gamePrivacy,'policies/site-privacy':c.policies.sitePrivacy};
const policyDocument = route.startsWith('policies/') ? policyDocuments[route.slice('policies/'.length) as keyof typeof policyDocuments][locale] : undefined;
const policyEffectiveDate = route.startsWith('policies/') && !isPolicyDraft(route) ? policyReadiness[route.slice('policies/'.length) as PolicyKey].effectiveDate : null;
---
<Layout locale={locale} route={route}>
  {route === '' && <>
    <section class="hero wrap">
      <div class="hero-copy"><p class="eyebrow">{facts.tagline}</p><h1>{c.home.title}</h1><div class="hero-description">{c.home.description.map((p,i)=><p>{ko && i===1 ? p.split(", ").map((line,j)=><span class="hero-copy-line">{line}{j===0 ? ", " : ""}</span>) : p}</p>)}</div><a class="hero-link" href="#our-philosophy">{c.home.philosophyCta}<span aria-hidden="true">↗</span></a></div>
    </section>
    <section class="home-philosophy wrap" id="our-philosophy">
      <div class="section-heading"><h2>{c.philosophy.title}</h2><span class="section-note">DETAIL + LOOP</span></div>
      <div class="philosophy-highlights">{c.philosophy.highlights.map(item=><article><span class="number">{item.number}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
      <details class="philosophy-disclosure"><summary><span class="when-closed">{c.philosophy.expandLabel}</span><span class="when-open">{c.philosophy.collapseLabel}</span></summary><div class="expanded-principles">{c.philosophy.principles.map((p,i)=><article><span class="number">0{i+1}</span><div><h3>{p.title}</h3><p>{p.body}</p></div></article>)}<a class="text-link" href={pathFor(locale,'philosophy')}>{c.philosophy.pageLink}<span>↗</span></a></div></details>
    </section>
    <section class="section wrap home-game home-game-row">
      <a class="spotlight-art" href={pathFor(locale,'games/hoegwi-button')} aria-label={c.home.gameCta}><img src="/media/room.webp" width="1536" height="1024" alt={ko?'회귀버튼의 생활 공간':'A living space in 회귀버튼'} loading="lazy"/><img class="spotlight-icon" src="/media/icon-a.webp" width="768" height="768" alt="" loading="lazy"/></a>
      <div class="spotlight-copy"><p class="eyebrow">{c.games.released}</p><h2>{c.home.gameTagline}</h2><p>{c.home.gameDescription}</p><a class="text-link" href={pathFor(locale,'games/hoegwi-button')}>{c.home.gameCta}<span>↗</span></a></div>
    </section>
    <section class="section studio-intro wrap"><div class="studio-intro-copy"><span class="eyebrow">THE STUDIO</span><h2>{c.home.studioTitle}</h2><div class="intro-body">{c.home.studioDescription.map(p=><p>{p}</p>)}<a class="text-link" href={pathFor(locale,'studio')}>{c.home.studioCta}<span>↗</span></a></div></div><div class="logo-panel"><img src="/media/detailoop-logo.png" width="1254" height="1254" alt={facts.brand} loading="lazy"/></div></section>
    <section class="news-teaser wrap"><div><span class="eyebrow">03 — FROM THE STUDIO</span><h2>{c.home.newsTitle}</h2><p>{c.home.newsDescription}</p></div><a class="button outline" href={pathFor(locale,'news')}>{c.home.newsCta}<span>↗</span></a></section>
  </>}
  {route === 'philosophy' && <>
    <section class="page-intro wrap"><p class="eyebrow">OUR PHILOSOPHY</p><h1>{c.philosophy.title}</h1><p class="lede">{c.philosophy.intro}</p></section>
    <div class="principles wrap">{c.philosophy.principles.map((p,i)=><section class="principle" id={`principle-${i+1}`}><span class="number">0{i+1}</span><h2>{p.title}</h2><p>{p.body}</p></section>)}</div>
    <section class="closing-note wrap"><span>DETAIL <i>+</i> LOOP</span><p>{c.studio.tagline}</p><a class="text-link" href={pathFor(locale,'games')}>{c.nav.games}<span>↗</span></a></section>
  </>}
  {route === 'games' && <><section class="page-intro wrap"><p class="eyebrow">OUR GAMES</p><h1>{c.games.title}</h1><p class="lede">{c.games.intro}</p></section><section class="wrap listing"><GameCard locale={locale}/></section></>}
  {route === 'games/hoegwi-button' && <>
    <section class="game-hero wrap"><div><a class="back-link" href={pathFor(locale,'games')}>← {c.nav.games}</a><div class="game-identity"><img src="/media/icon-a-small.webp" width="256" height="256" alt={c.game.name}/><div><span class="eyebrow">{ko?'출시작':'RELEASED GAME'}</span><h1>{c.game.name}</h1></div></div><h2>{c.game.tagline}</h2><p class="lede">{c.home.gameDescription}</p><StoreButton locale={locale}/></div><div class="game-hero-art"><img src="/media/room.webp" width="1536" height="1024" alt={ko?'회귀버튼 속 생활 공간 배경':'A living space from 회귀버튼'} fetchpriority="high"/><span>2006.<small>{ko?'다시 시작할 시간.':'A chance to begin again.'}</small></span></div></section>
    <section class="game-story wrap"><span class="eyebrow">YOUR LIFE, AGAIN</span><div>{c.game.paragraphs.map((p,i)=> i===0 ? <h2>{p}</h2> : <p>{p}</p>)}</div></section>
    <section class="game-features wrap">{c.game.features.map((f,i)=><article><span class="number">0{i+1}</span><h3>{f.title}</h3><p>{f.body}</p></article>)}</section>
    <section class="screens-section"><div class="wrap"><p class="eyebrow">INSIDE THE GAME</p><h2>{c.game.screenshotsTitle}</h2><p>{c.game.screenshotsIntro}</p><p class="media-note">{c.game.mediaNote}</p><div class="screens">{screens.map(([key,label])=><figure><a href={`/media/screen-${key}.webp`} target="_blank" aria-label={`${label} — ${ko?'크게 보기':'View full image'}`}><img src={`/media/screen-${key}.webp`} width={key==='story'?432:417} height={key==='story'?768:741} alt={`${c.game.name} — ${label}`} loading="lazy"/></a><figcaption>{label}</figcaption></figure>)}</div></div></section>
    <section class="intro-section wrap"><div><p class="eyebrow">THE BEGINNING</p><h2>{c.game.introTitle}</h2><p>{c.game.introDescription}</p><p class="media-note">{ko?'게임 인트로 영상 · 24초':'Game intro film · 24 seconds'}</p></div><video controls playsinline preload="none" poster="/media/intro-poster.webp" width="720" height="1280" aria-label={c.game.introTitle}><source src="/media/intro.mp4" type="video/mp4"/><p>{ko?'이 브라우저에서는 영상을 재생할 수 없습니다.':'Your browser does not support this video.'}</p></video></section>
    <section class="game-bottom wrap"><h2>{c.game.name}</h2><div class="actions"><StoreButton locale={locale}/><a class="text-link" href={pathFor(locale,'news')}>{c.game.updatesCta}<span>→</span></a><a class="text-link" href={pathFor(locale,'contact')}>{c.game.supportCta}<span>→</span></a><a class="text-link" href={`${pathFor(locale,'contact')}#account-deletion`}>{ko?'온라인 계정 삭제 요청':'Online account deletion'}<span>→</span></a></div></section>
  </>}
  {route === 'studio' && <>
    <section class="page-intro wrap"><p class="eyebrow">THE STUDIO</p><h1>{c.studio.title}</h1><p class="lede">{c.studio.tagline}</p></section>
    <section class="studio-statement wrap"><div class="logo-panel"><img src="/media/detailoop-logo.png" width="1254" height="1254" alt={facts.brand}/></div><div>{c.studio.description.map(p=><p>{p}</p>)}<div class="actions"><a class="text-link" href={pathFor(locale,'philosophy')}>{c.home.philosophyCta}<span>↗</span></a><a class="text-link" href={pathFor(locale,'games')}>{ko?'게임 살펴보기':'Explore our games'}<span>↗</span></a></div></div></section>
    <Founder locale={locale}/>
  </>}
  {route === 'studio/park-jaeyoung' && <>
    <section class="page-intro wrap"><a class="back-link" href={pathFor(locale,'studio')}>← {c.nav.studio}</a><p class="eyebrow">STUDIO LEAD & DEVELOPER</p><h1>{facts.personName}</h1><p class="lede">{c.founder.role}</p></section>
    <article class="profile wrap"><div class="profile-copy"><p>{c.founder.intro}</p><p>{c.founder.approach}</p></div><div class="profile-facts"><section><h2>{c.founder.activitiesLabel}</h2><p>{c.founder.activity}</p><p class="profile-responsibility">{c.founder.responsibility}</p></section><section><h2>{c.founder.bioLabel}</h2><ul>{c.founder.bio.map(b=><li>{b}</li>)}</ul></section></div></article>
  </>}
  {route === 'news' && <>
    <section class="page-intro wrap"><p class="eyebrow">NEWS & SUPPORT</p><h1>{c.news.title}</h1><p class="lede">{c.news.intro}</p></section>
    <section class="news-categories wrap">{c.news.categories.slice(0,3).map((cat,i)=><div><span class="number">0{i+1}</span><h2>{cat.title}</h2><p>{cat.body}</p></div>)}</section>
    {posts.length ? <div class="post-list wrap">{[...posts].sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt)).map(post=><a href={pathFor(locale,`news/${post.slug}`)}><span class="eyebrow">{c.news.categories[newsCategories.indexOf(post.category)].title} · <time datetime={post.publishedAt}>{post.publishedAt}</time></span><h2>{post[locale].title}</h2><p>{post[locale].summary}</p><span class="post-arrow">↗</span></a>)}</div> : <div class="empty-state wrap"><span aria-hidden="true">✳</span><p>{c.news.empty}</p></div>}
    <section class="support-links wrap"><a href={pathFor(locale,'contact')}><h2>{c.news.categories[3].title}</h2><p>{c.news.categories[3].body}</p><span>↗</span></a><a href={pathFor(locale,'policies')}><h2>{c.policies.title}</h2><p>{c.policies.intro}</p><span>↗</span></a></section>
  </>}
  {route === 'contact' && <>
    <section class="page-intro wrap"><p class="eyebrow">CONTACT</p><h1>{c.contact.title}</h1><p class="lede">{c.contact.intro}</p></section>
    <section class="contact-panel wrap"><div><span class="eyebrow">EMAIL</span><a class="email" href={`mailto:${facts.email}`}>{facts.email}<span>↗</span></a><p>{c.contact.help}</p></div><aside><span class="tiny-dot"></span><h2>{c.game.supportCta}</h2><a class="text-link" href={pathFor(locale,'policies')}>{c.policies.title}<span>→</span></a></aside></section>
    <section class="account-deletion policy-document wrap" id="account-deletion" aria-labelledby="account-deletion-title">
      <span class="eyebrow">ACCOUNT DELETION</span>
      <h2 id="account-deletion-title">{c.contact.deletionTitle}</h2>
      <p>{c.contact.deletionIntro}</p>
      <ol>{c.contact.deletionSteps.map(step=><li>{step}</li>)}</ol>
      <a class="text-link" href={`mailto:${facts.email}?subject=${encodeURIComponent(c.contact.deletionSubject)}`}>{c.contact.deletionCta}<span>↗</span></a>
      <p class="media-note">{facts.email}</p>
      <p>{c.contact.deletionSafety}</p>
      <p>{ko ? `운영 DB에서 삭제된 정보는 최대 ${d1RecoveryDays}일간 복구 이력에 남을 수 있습니다. 요청 이메일과 처리 내용은 요청을 처리한 뒤 ${supportRetentionDays}일 이내에 삭제합니다.` : `Data deleted from the live database may remain in recovery history for up to ${d1RecoveryDays} days. We delete the request email and related correspondence within ${supportRetentionDays} days after resolving the request.`}</p>
      <p class="media-note">{c.contact.deletionPreview}</p>
    </section>
  </>}
  {route === 'policies' && <>
    <section class="page-intro wrap"><p class="eyebrow">POLICIES</p><h1>{c.policies.title}</h1><p class="lede">{c.policies.intro}</p></section>
    <div class="policy-links wrap">{Object.entries(policyNames).filter(([path])=>includedRoutes.includes(path as Route)).map(([path,name])=><a href={pathFor(locale,path)}><span>{name}{isPolicyDraft(path) && <small class="policy-state">{c.policies.status}</small>}</span><span>↗</span></a>)}</div>
  </>}
  {route.startsWith('policies/') && <>
    <section class="page-intro wrap"><a class="back-link" href={pathFor(locale,'policies')}>← {c.policies.title}</a><p class="eyebrow">POLICIES</p><h1>{policyNames[route]}</h1></section>
    {policyDocument && <article class="policy-document wrap">
      {isPolicyDraft(route) && <div class="policy-review-banner"><span class="status-label">{c.policies.status}</span><p>{ko?'아래 내용은 검토용 초안이며 아직 시행된 약관·방침이 아닙니다. 미확정 사항을 확인한 뒤 적용일과 최종 문구를 정합니다.':'This is a review draft, not an effective policy or agreement. The effective date and final wording will be set after the outstanding items have been confirmed.'}</p></div>}
      {policyEffectiveDate && <p class="policy-effective-date">{ko?'시행일':'Effective date'}: <time datetime={policyEffectiveDate}>{policyEffectiveDate}</time></p>}
      {route === 'policies/site-privacy' && !isPolicyDraft(route) && !policyEffectiveDate && <p class="policy-effective-date">{ko?'이 안내는 홈페이지 공개일부터 적용됩니다.':'This notice applies from the date the website is published.'}</p>}
      <p class="policy-summary">{policyDocument.summary}</p>
      <nav class="policy-contents" aria-label={ko?'문서 목차':'Document contents'}><ol>{policyDocument.sections.map((section,i)=><li><a href={`#policy-section-${i+1}`}>{section.heading}</a></li>)}</ol></nav>
      <div class="policy-body">{policyDocument.sections.map((section,i)=><section id={`policy-section-${i+1}`}><h2><span>{String(i+1).padStart(2,'0')}</span>{section.heading}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>)}</div>
      {policyDocument.sources && <ul aria-label={ko?'관련 안내':'Related information'}>{policyDocument.sources.map(source=><li><a class="text-link" href={source.url}>{source.label}</a></li>)}</ul>}
      {isPolicyDraft(route) && !!policyDocument.reviewNotes?.length && <aside class="policy-review-notes"><h2>{ko?'공개 전 확인할 사항':'Items to confirm before publication'}</h2><ul>{policyDocument.reviewNotes.map(note=><li>{note}</li>)}</ul></aside>}
      <a class="text-link" href={`mailto:${facts.email}`}>{facts.email}<span aria-hidden="true">↗</span></a>
    </article>}
  </>}
</Layout>




